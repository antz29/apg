<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>csharpfrontend</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.Extensions" Version="6.0.36" />
    <PackageReference Include="Microsoft.AspNetCore.Razor.Language" Version="6.0.36" />
    <PackageReference Include="Microsoft.CodeAnalysis.Razor" Version="6.0.36" />
  </ItemGroup>

  <!-- The test harness is a separate project under tests/ (run via `dotnet
       run` with its project path); it must never be compiled into the
       production scanner (a second entry point). The glob is broad enough to
       also cover tests/obj/**. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <!-- Carried runtime: embed the Microsoft.NETCore.App targeting-pack reference
       assemblies this build compiles against (as resolved by the SDK for
       net9.0) under the `apg.refs/` prefix, so the scanner binds System types
       identically under `dotnet run` and the single-file publish. -->
  <Target Name="EmbedCarriedRuntimeReferences"
          DependsOnTargets="ResolveTargetingPackAssets"
          BeforeTargets="PrepareResourceNames">
    <ItemGroup>
      <EmbeddedResource Include="@(Reference)"
                        Condition="'%(Reference.FrameworkReferenceName)' == 'Microsoft.NETCore.App' And '%(Reference.Extension)' == '.dll'"
                        LogicalName="apg.refs/%(Reference.Filename)%(Reference.Extension)"
                        WithCulture="false"
                        Type="Non-Resx" />
    </ItemGroup>
  </Target>
</Project>
