<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Framework-free console test harness for the SQL frontend (mirrors
    src/csharplib/tests/CsharpFrontend.Tests.csproj). Run it with `dotnet run`
    and this project's path (src/sqllib/tests/SqlFrontend.Tests.csproj).
    SqlFrontend.csproj excludes this tree from its compile glob.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>SqlFrontend.Tests</AssemblyName>
    <RootNamespace>SqlFrontend.Tests</RootNamespace>
    <!-- A framework-dependent project cannot reference the self-contained scanner (NETSDK1151). -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test build needs only the scanner's framework-dependent assembly, not its publish shape. -->
    <ProjectReference Include="../SqlFrontend.csproj">
      <AdditionalProperties>SelfContained=false;PublishSingleFile=false;PublishReadyToRun=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
