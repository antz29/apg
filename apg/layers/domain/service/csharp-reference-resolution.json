      "properties": {}
    },
    {
      "kind": "driven-by",
      "target": "requirements.requirement.csharp-unresolvable-reference-target",
      "properties": {}
    },
    {
      "kind": "reads",
      "target": "domain.entity.dotnet-project",
      "properties": {}
    },
    {
      "kind": "reads",
      "target": "domain.entity.restored-reference-artefact",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "domain.group.csharp-frontend",
      "properties": {}
    },
    {
      "kind": "realises",
      "source": "solution.component.csharp-reference-resolver",
      "properties": {}
