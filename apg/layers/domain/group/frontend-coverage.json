{
  "layer": "domain",
  "type": "group",
  "name": "frontend-coverage",
  "body": "The frontend-coverage domain: what source a scan actually sees and emits. Covers the set of projects and source files a frontend discovers (Cargo manifests including nested non-workspace projects; JS/TS source files across the accepted extension set; markdown documents across the accepted extension set), the exclusions that keep generated/dependency trees out, the discovery/detection/emission services, and the identity values (manifest root, module FQN prefix, language id, code type) that make discovery deterministic and FQN-safe. Aggregate root: frontend-coverage.",
  "properties": {
    "attribute": "core",
    "root": "frontend-coverage"
  },
  "out": [
    {
      "kind": "contains",
      "target": "domain.entity.cargo-manifest",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.entity.scan-exclusion",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.entity.source-file",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.service.fact-emission",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.service.language-detection",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.service.manifest-discovery",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.value.code-type",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.value.language-id",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.value.manifest-root",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.value.module-fqn-prefix",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.container.frontend-process",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.container.ingestor",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.container.scan-orchestrator",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "drives",
      "source": "requirements.requirement.js-ts-acceptance",
      "properties": {}
    },
    {
