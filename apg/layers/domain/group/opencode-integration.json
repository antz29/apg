{
  "layer": "domain",
  "type": "group",
  "name": "opencode-integration",
  "body": "The apg opencode integration as the opencode 2.x extension surface: the plugin definition each suite tool is expressed as, the tool registration it adds, and the permission rules each agent carries.",
  "properties": {
    "attribute": "supporting",
    "root": "opencode-plugin-definition"
  },
  "out": [
    {
      "kind": "contains",
      "target": "domain.entity.opencode-permission-rule-set",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.entity.opencode-plugin-definition",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.entity.opencode-tool-registration",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.value.opencode-plugin-api",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.opencode-docs",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.opencode-install-layout",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.container.opencode-suite",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.container.scanner-cli",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "drives",
      "source": "requirements.requirement.opencode-2x-support",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.opencode-docs-v2",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.opencode-suite-install-v2",
      "properties": {}
    }
  ]
}