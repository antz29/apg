{
  "layer": "domain",
  "type": "group",
  "name": "scan-cache",
  "body": "The scan-cache subdomain: the shared, content-addressed store of prior scanner facts and the keying/invalidation rules that decide reuse. Contains the content manifest (path -> git blob OID), the per-file fact cache, the cache key (binary/format/config version), and the freshness check that decides the fast-path.",
  "properties": {
    "attribute": "core"
  },
  "out": [
    {
      "kind": "contains",
      "target": "domain.entity.content-manifest",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.entity.fact-cache",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.service.freshness-check",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "domain.value.cache-key",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.fact-cache",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.delta-analyzer",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "target": "solution.component.freshness-gate",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "domain.group.incremental-scan",
      "properties": {}
    },
    {
      "kind": "drives",
      "source": "requirements.requirement.incremental-content",
      "properties": {}
    }
  ]
}