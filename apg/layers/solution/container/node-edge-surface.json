{
  "layer": "solution",
  "type": "container",
  "name": "node-edge-surface",
  "body": "The `apg node` / `apg edge` durable mutation surface: strict add / update / rm over node files and both edge halves, with no implicit upsert, plus the edge-preserving node/edge write primitive. Container of the CLI system.",
  "properties": {
    "kind": "app"
  },
  "out": [
    {
      "kind": "contains",
      "target": "solution.component.node-mutations",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.edge-mutations",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.node-file-primitive",
      "properties": {}
    },
    {
      "kind": "implemented-by",
      "target": "apg.node_cmd.cmd_node",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.mutation-commit-staging",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "solution.system.apg-cli",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "source": "domain.entity.authored-node",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "source": "domain.entity.authored-edge",
      "properties": {}
    }
  ]
}