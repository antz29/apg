      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.freshness-gate",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.impact-closure",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.language-detector",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.phase-timer",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "solution.system.apg-scan",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "source": "domain.group.frontend-coverage",
      "properties": {}
    }
  ]
}