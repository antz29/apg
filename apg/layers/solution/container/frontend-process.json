{
  "layer": "solution",
  "type": "container",
  "name": "frontend-process",
  "body": "The per-language scanner frontends (Go src/golib, Java src/javalib, C++ src/cpplib, Rust src/rustlib, TS src/tslib, C# src/csharplib). They must accept a target set, resolve against the full compilation context, emit only the target, and use their native incremental/artifact cache.",
  "properties": {
    "kind": "service"
  },
  "out": [
    {
      "kind": "contains",
      "target": "solution.component.js-ts-frontend",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "solution.component.rust-manifest-discovery",
      "properties": {}
    },
    {
      "kind": "implemented-by",
      "target": "Apg.CsharpFrontend.Program.Main",
      "properties": {}
    },
    {
      "kind": "implemented-by",
      "target": "CallGraphBuilder.main",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "solution.system.apg-scan",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "source": "domain.entity.scan-exclusion",
      "properties": {}
    },
    {
      "kind": "realised-by",
      "source": "domain.group.frontend-coverage",
      "properties": {}
    }
  ]
}