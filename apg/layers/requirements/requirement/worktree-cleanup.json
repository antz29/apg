{
  "layer": "requirements",
  "type": "requirement",
  "name": "worktree-cleanup",
  "body": "Project lifecycle must be self-cleaning: `apg project merge <name>` removes its worktree and deletes its branch after a successful merge, and abandoned (never-merged) projects can be explicitly deleted via a new `apg project delete <name>` subcommand. Safety is a hard law: cleanup never touches the default branch or the main checkout.",
  "properties": {
    "feature": "project-lifecycle"
  },
  "out": [
    {
      "kind": "contains",
      "target": "requirements.requirement.merge-self-cleanup",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.delete-subcommand",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.delete-refuses-unsafe",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.group.project-lifecycle",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "details",
      "source": "requirements.note.leftover-worktrees",
      "properties": {}
    },
    {
      "kind": "contains",
      "source": "requirements.user.project-operator",
      "properties": {}
    },
    {
      "kind": "contains",
      "source": "requirements.stakeholder.repo-owner",
      "properties": {}
    }
  ]
}