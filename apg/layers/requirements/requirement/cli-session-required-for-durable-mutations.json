{
  "layer": "requirements",
  "type": "requirement",
  "name": "cli-session-required-for-durable-mutations",
  "body": "A durable node or edge mutation runs only through a live session holding the worktree database, and with the session absent the command reports that a session is required.",
  "properties": {
    "feature": "cli-session-substrate"
  },
  "out": [
    {
      "kind": "drives",
      "target": "domain.entity.cli-session-coordinator",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.group.cli-session",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.service.cli-session-routing",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.requirement.cli-session-substrate",
      "properties": {}
    }
  ]
}