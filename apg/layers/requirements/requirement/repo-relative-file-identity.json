{
  "layer": "requirements",
  "type": "requirement",
  "name": "repo-relative-file-identity",
  "body": "A source file's canonical identity is its path relative to the git toplevel with forward slashes, free of its absolute path and of the scanned directory, falling back to the scan root outside a repository.",
  "properties": {
    "feature": "graph-identity"
  },
  "out": [
    {
      "kind": "drives",
      "target": "domain.entity.source-file",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.group.graph-identity",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.value.canonical-file-identity",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.value.repo-relative-path",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.requirement.portable-graph-identity",
      "properties": {}
    }
  ]
}