    },
    {
      "kind": "contains",
      "target": "requirements.requirement.ps-error-count",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.ps-error-recovery",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.ps-error-report",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.ps-line-spans",
      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.ps-text-encoding",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
