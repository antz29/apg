      "properties": {}
    },
    {
      "kind": "contains",
      "target": "requirements.requirement.init-reports-agent-count",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.requirement.opencode-2x-support",
      "properties": {}
    },
    {
      "kind": "driven-by",
      "source": "domain.service.opencode-integration",
      "properties": {}
    }
  ]
}
