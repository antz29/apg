{
  "layer": "requirements",
  "type": "requirement",
  "name": "opencode-suite-install-v2",
  "body": "apg init installs the opencode 2.x suite into the global opencode config directory, installing the tool plugins, the shared library, and the seven distributed agents, and idempotently pruning apg-owned files absent from the installed set.",
