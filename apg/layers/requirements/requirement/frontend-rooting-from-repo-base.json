{
  "layer": "requirements",
  "type": "requirement",
  "name": "frontend-rooting-from-repo-base",
  "body": "Every frontend's package and module identity derives from the repository-relative base rather than the checkout-directory basename, and each source file is emitted under exactly one module identity.",
  "properties": {
    "feature": "graph-identity"
  },
  "out": [
    {
      "kind": "drives",
      "target": "domain.entity.typescript-package",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.group.graph-identity",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.value.module-identity",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.requirement.portable-graph-identity",
      "properties": {}
    }
  ]
}