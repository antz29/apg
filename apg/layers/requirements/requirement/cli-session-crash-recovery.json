{
  "layer": "requirements",
  "type": "requirement",
  "name": "cli-session-crash-recovery",
  "body": "A socket that answers a connect and a ping marks a live session, and a present socket that fails to answer marks an unclean exit whose derived index is discarded and rebuilt from the on-disk node files.",
  "properties": {
    "feature": "cli-session-substrate"
  },
  "out": [
    {
      "kind": "drives",
      "target": "domain.entity.cli-session-coordinator",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.group.cli-session",
      "properties": {}
    },
    {
      "kind": "drives",
      "target": "domain.value.cli-session-socket",
      "properties": {}
    }
  ],
  "in": [
    {
      "kind": "contains",
      "source": "requirements.requirement.cli-session-substrate",
      "properties": {}
    }
  ]
}